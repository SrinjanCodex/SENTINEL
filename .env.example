# Backend API Base URL (used in Milestone 2+)
VITE_API_BASE_URL=http://localhost:8000

# Set to true for Milestone 1 (browser localStorage + demo data)
VITE_USE_MOCK_API=true

# ─────────────────────────────────────────────────────────────────────────────
# MAP CONFIGURATION (Default: Centered on India)
# ─────────────────────────────────────────────────────────────────────────────
# Default geographic center (India) & overview zoom level
VITE_MAP_DEFAULT_LAT=22.5
VITE_MAP_DEFAULT_LNG=79.0
VITE_MAP_DEFAULT_ZOOM=5

# Working default tile provider: Standard OpenStreetMap (100% free, zero keys required)
# Note: Standard OSM tiles display local territorial scripts.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors
# Optional free API key (leave empty when using standard OpenStreetMap)
# If provided without a custom URL, automatically activates MapTiler English labels.
VITE_MAP_API_KEY=

# ── Optional: English / Latin-script labels via external providers ───────────
# If you prefer labels in English, you can sign up for a free API key with one of
# the following providers (no credit card or paid plan required):
#
# Option A: CARTO Voyager (Free key at https://carto.com/basemaps/apikey/)
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?api_key={apiKey}
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions" target="_blank" rel="noopener">CARTO</a>
# VITE_MAP_API_KEY=your_carto_key_here
#
# Option B: MapTiler Streets (Free account at https://www.maptiler.com/ - 100k requests/mo)
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key={apiKey}
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/" target="_blank">&copy; MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">&copy; OpenStreetMap contributors</a>
# VITE_MAP_API_KEY=your_maptiler_key_here
#
# Option C: Stadia Maps Alidade Smooth (Free account at https://stadiamaps.com/ - 200k requests/mo)
# VITE_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png?api_key={apiKey}
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://stadiamaps.com/" target="_blank">&copy; Stadia Maps</a> &copy; <a href="https://openmaptiles.org/" target="_blank">&copy; OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">&copy; OpenStreetMap contributors</a>
# VITE_MAP_API_KEY=your_stadia_key_here
